---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | HPoblete Lab">
  <div class="max-w-7xl mx-auto px-6 pt-40 pb-32 min-h-[70vh]">
    <h1 class="text-5xl md:text-6xl font-bold text-lab-dark dark:text-gray-100 border-l-4 border-lab-red pl-4 mb-6">Page not found</h1>
    <p class="text-xl text-gray-600 dark:text-gray-400">
      The page you are looking for does not exist. <a href="/" class="text-lab-blue dark:text-blue-400 underline">Return to the home page</a>.
    </p>
  </div>
</Layout>
