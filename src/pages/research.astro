---
// src/pages/research.astro
// Research lines are edited in src/data/research.json.
import Layout from '../layouts/Layout.astro';
import research from '../data/research.json';

interface Paper { title: string; venue: string; doi: string; }
interface Line { light?: boolean; id: string; title: string; teaser: string; summary: string; image?: string; alt?: string; papers: Paper[]; }

const lines = research as Line[];
---

<Layout title="Research | HPoblete Lab">
  <section class="lattice panel mx-2 md:mx-4 mt-2">
    <div class="page py-16 md:py-24">
      <h1 class="text-4xl md:text-6xl font-medium tracking-tight">Research</h1>
      <p class="mt-6 text-xl md:text-2xl leading-snug text-white/75 max-w-[50ch]">
        A peptide, a lipid or a protein behaves differently once it touches a material. We use molecular simulation to see how, atom by atom, and to turn that into design rules.
      </p>
    </div>
  </section>

  <div class="page">
    {lines.map((line, i) => (
      <section id={line.id} class="scroll-mt-20 py-12 md:py-16 grid md:grid-cols-12 gap-x-12 gap-y-8 items-center">
        {line.image && (
          <img
            src={line.image}
            alt={line.alt}
            loading={i === 0 ? 'eager' : 'lazy'}
            class:list={['rise soft w-full h-auto max-h-[36rem] md:col-span-6', line.light ? 'object-contain' : 'object-cover', i % 2 === 1 && 'md:order-2']}
          />
        )}
        <div class:list={[line.image ? 'md:col-span-6' : 'md:col-span-8']}>
          <h2 class="h-section">{line.title}</h2>
          <p class="mt-4 text-lg leading-relaxed max-w-[60ch]">{line.summary}</p>

          {line.papers.length > 0 && (
            <ul class="mt-6 space-y-3">
              {line.papers.map((paper) => (
                <li>
                  <a href={`https://doi.org/${paper.doi}`} target="_blank" rel="noopener noreferrer" class="lift soft block bg-wash hover:bg-white px-5 py-3.5">
                    {paper.title}
                    <span class="block text-muted"><em>{paper.venue}</em></span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    ))}
  </div>
</Layout>
