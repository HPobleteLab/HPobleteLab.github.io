---
// src/pages/research.astro
// Research lines are edited in src/data/research.json.
import Layout from '../layouts/Layout.astro';
import research from '../data/research.json';

interface Paper { title: string; doi: string; }
interface Line { title: string; summary: string; papers: Paper[]; }

const lines = research as Line[];
---

<Layout title="Research | HPoblete Lab">
  <div class="page pt-12 md:pt-16">
    <h1 class="text-4xl md:text-5xl font-medium tracking-tight">Research</h1>
    <p class="mt-6 text-lg md:text-xl leading-relaxed text-muted max-w-[58ch]">
      We use state-of-the-art computational tools to simulate and understand the interface between biological molecules and engineered nanomaterials.
    </p>

    <figure class="mt-12 md:mt-16">
      <img
        src="/images/nanoparticle-membrane.webp"
        width="1800"
        height="1002"
        alt="Render of a coated nanoparticle embedded in a layer of molecules."
        class="w-full h-auto max-w-5xl mx-auto"
      />
      {/* TODO: caption for this render (system, method, reference). */}
    </figure>

    <div class="mt-12 md:mt-16 border-t border-line">
      {lines.map((line) => (
        <section class="py-10 border-b border-line grid md:grid-cols-12 gap-x-12 gap-y-4">
          <h2 class="md:col-span-4 text-2xl font-medium tracking-tight">{line.title}</h2>
          <div class="md:col-span-8">
            <p class="text-lg leading-relaxed max-w-[62ch]">{line.summary}</p>
            {line.papers.length > 0 && (
              <ul class="mt-6 space-y-2 text-muted">
                {line.papers.map((paper) => (
                  <li><a href={`https://doi.org/${paper.doi}`} target="_blank" rel="noopener noreferrer" class="link">{paper.title}</a></li>
                ))}
              </ul>
            )}
          </div>
        </section>
      ))}
    </div>
  </div>
</Layout>
