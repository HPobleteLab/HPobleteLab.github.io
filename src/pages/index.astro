---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import research from '../data/research.json';
import funding from '../data/funding.json';
import publications from '../data/publications.json';

const featured = research.filter((line) => line.image);
const latest = publications.slice(0, 4);
---

<Layout title="HPoblete Lab | Bio-nanomaterial Simulations Group">

  <!-- Hero: the group's render, edge to edge. On wide screens the name sits in the
       empty sky between the two nanoparticles; sizes are relative to the image width. -->
  <section class="hero relative bg-night">
    <img
      src="/images/banner-2400.jpg"
      srcset="/images/banner-1200.jpg 1200w, /images/banner-2400.jpg 2400w"
      sizes="100vw"
      width="2400"
      height="1154"
      alt="Rendered molecular systems studied by the group: a lipid nanoparticle and a coated nanoparticle above peptides adsorbed on a flat surface."
      class="block w-full h-auto max-md:aspect-[3/2] max-md:object-cover"
      fetchpriority="high"
    />
    <div class="hero-title max-md:hidden">
      <h1>HPoblete Lab</h1>
      <p>Bio-nanomaterial Simulations Group</p>
    </div>
  </section>

  <section class="page py-16 md:py-24 grid md:grid-cols-12 gap-x-12 gap-y-8 items-end">
    <div class="md:col-span-7">
      <h1 class="md:hidden text-muted mb-3">HPoblete Lab, Bio-nanomaterial Simulations Group</h1>
      <p class="text-[2rem] leading-[1.15] md:text-[3rem] md:leading-[1.08] font-medium tracking-tight">
        We simulate what happens where biomolecules meet nanomaterials.
      </p>
    </div>
    <div class="md:col-span-5">
      <p class="text-lg leading-relaxed text-muted">
        We are a computational biophysics group at Universidad de Talca, Chile. With molecular dynamics we study peptides, lipids and proteins on nanoparticles and surfaces, and use what we learn to help design materials for medicine and the environment.
      </p>
      <p class="mt-6 flex flex-wrap gap-3">
        <a href="/research" class="btn">Our research</a>
        <a href="/team" class="btn btn-quiet">Meet the team</a>
      </p>
    </div>
  </section>

  <section class="bg-wash py-16 md:py-24">
    <div class="page">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="h-section">Research</h2>
        <a href="/research" class="link">All research lines</a>
      </div>

      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {featured.map((line) => (
          <a href="/research" class="group block bg-white">
            <div class="aspect-[4/3] overflow-hidden bg-white">
              <img src={line.image} alt={line.alt} loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]" />
            </div>
            <div class="p-6">
              <h3 class="text-xl font-medium tracking-tight group-hover:text-accent">{line.title}</h3>
              <p class="mt-2 text-muted leading-relaxed line-clamp-4">{line.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {latest.length > 0 && (
    <section class="page py-16 md:py-24">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="h-section">Recent publications</h2>
        <a href="/publications" class="link">All publications</a>
      </div>

      <ol class="mt-10 grid gap-x-12 gap-y-10 md:grid-cols-2">
        {latest.map((pub) => (
          <li class="border-t-2 border-ink pt-4">
            <p class="text-muted"><em>{pub.journal}</em>, {pub.year}</p>
            <h3 class="mt-1 text-xl font-medium leading-snug">
              <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener noreferrer" class="hover:text-accent">{pub.title}</a>
            </h3>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section class="bg-wash py-16 md:py-24">
    <div class="page grid md:grid-cols-12 gap-x-12 gap-y-8">
      <h2 class="h-section md:col-span-4">Funding</h2>

      <div class="md:col-span-8">
        {funding.current.map((item) => (
          <div class="bg-white p-8 border-l-4 border-accent">
            <p class="text-2xl font-medium tracking-tight">{item.grant}</p>
            <p class="mt-1 text-muted">Project No. {item.number}, {item.agency}</p>
            <p class="mt-1 text-muted">{item.role}</p>
          </div>
        ))}

        <details class="mt-6">
          <summary class="cursor-pointer text-muted hover:text-ink">Past funding</summary>
          <ul class="mt-4 border-t border-line">
            {funding.past.map((item) => (
              <li class="py-4 border-b border-line">
                <p><span class="font-medium">{item.grant}</span> <span class="text-muted">({item.years})</span></p>
                <p class="text-muted">{item.role}</p>
                {item.project && <p class="mt-1 text-muted italic">{item.project}</p>}
              </li>
            ))}
          </ul>
        </details>
      </div>
    </div>
  </section>

</Layout>

<style>
  .hero {
    container-type: inline-size;
  }
  /* Centred on the gap between the two nanoparticles (about 54% across). */
  .hero-title {
    position: absolute;
    top: 7%;
    left: 54.5%;
    transform: translateX(-50%);
    width: 30cqw;
    text-align: center;
    color: var(--color-ink);
  }
  .hero-title h1 {
    font-size: 3.7cqw;
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .hero-title p {
    margin-top: 0.9cqw;
    font-size: 1.3cqw;
    font-weight: 500;
  }
</style>
