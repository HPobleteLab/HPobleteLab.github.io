---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import research from '../data/research.json';
import funding from '../data/funding.json';
---

<Layout title="HPoblete Lab | Bio-nanomaterial Simulations Group">

  <!-- Banner: the group's render, edge to edge. -->
  <img
    src="/images/banner-2400.jpg"
    srcset="/images/banner-1200.jpg 1200w, /images/banner-2400.jpg 2400w"
    sizes="100vw"
    width="2400"
    height="1154"
    alt="Rendered molecular systems studied by the group: two nanoparticles above peptides adsorbed on a flat surface."
    class="block w-full h-auto max-md:aspect-[3/2] max-md:object-cover"
    fetchpriority="high"
  />

  <section class="page pt-14 md:pt-20">
    <h1 class="text-[2rem] leading-[1.15] md:text-[3.25rem] md:leading-[1.08] font-medium tracking-tight max-w-[22ch]">
      We simulate the interface between biological molecules and engineered nanomaterials.
    </h1>
    <p class="mt-8 text-lg md:text-xl leading-relaxed text-muted max-w-[58ch]">
      The Bio-nanomaterial Simulations Group at Universidad de Talca works on theoretical and computational biophysics, specializing in protein adsorption on nanosurfaces.
    </p>
  </section>

  <section class="page mt-24 md:mt-32 grid md:grid-cols-12 gap-x-12 gap-y-10 items-start">
    <div class="md:col-span-5">
      <h2 class="text-2xl md:text-3xl font-medium tracking-tight">Research</h2>
      <ul class="mt-8 border-t border-line">
        {research.map((line) => (
          <li class="py-5 border-b border-line">
            <h3 class="font-medium text-lg">{line.title}</h3>
            <p class="mt-1.5 text-muted leading-relaxed">{line.summary}</p>
          </li>
        ))}
      </ul>
      <p class="mt-6"><a href="/research" class="link">More about our research</a></p>
    </div>

    <figure class="md:col-span-7">
      <img
        src="/images/peptides-graphite.jpg"
        width="1600"
        height="900"
        loading="lazy"
        alt="Close-up render of peptide chains lying on a surface."
        class="w-full h-auto"
      />
      {/* TODO: caption for this render (system, method, reference). */}
    </figure>
  </section>

  <section class="page mt-24 md:mt-32">
    <h2 class="text-2xl md:text-3xl font-medium tracking-tight">Funding</h2>
    <ul class="mt-8 border-t border-line">
      {funding.map((item) => (
        <li class="py-5 border-b border-line grid md:grid-cols-12 gap-x-12 gap-y-1">
          <p class="md:col-span-2 text-muted tabular-nums">{item.years}</p>
          <div class="md:col-span-4">
            <p class="font-medium">{item.grant}</p>
            <p class="text-muted">{item.role}</p>
          </div>
          <p class="md:col-span-6 text-muted italic leading-relaxed">{item.project}</p>
        </li>
      ))}
    </ul>
  </section>

</Layout>
