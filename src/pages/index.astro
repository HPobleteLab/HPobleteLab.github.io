---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import research from '../data/research.json';
import funding from '../data/funding.json';
import publications from '../data/publications.json';

const [lead, ...rest] = research;
const latest = publications.slice(0, 4);
---

<Layout title="HPoblete Lab | Bio-nanomaterial Simulations Group">

  <!-- First screen: the banner render and the summary fit together in one viewport.
       The banner is cropped vertically on short windows; the group name sits in the
       empty sky between the two nanoparticles, sized relative to the image width. -->
  <section class="hero relative">
    <img
      src="/images/banner-2400.jpg"
      srcset="/images/banner-1200.jpg 1200w, /images/banner-2400.jpg 2400w"
      sizes="100vw"
      width="2400"
      height="1154"
      alt="Rendered molecular systems studied by the group: a lipid nanoparticle and a coated nanoparticle above peptides adsorbed on a graphite sheet."
      class="hero-image"
      fetchpriority="high"
    />
    <div class="hero-fade" aria-hidden="true"></div>
    <div class="hero-title max-md:hidden">
      <h1>HPoblete Lab</h1>
      <p>Bio-nanomaterial Simulations Group</p>
    </div>
  </section>

  <section class="page pt-6 pb-12 md:pt-8 md:pb-16 grid md:grid-cols-12 gap-x-12 gap-y-6 items-end">
    <div class="md:col-span-7">
      <h1 class="md:hidden text-muted mb-3">HPoblete Lab, Bio-nanomaterial Simulations Group</h1>
      <p class="text-[2rem] leading-[1.12] md:text-[3.25rem] md:leading-[1.05] font-medium tracking-tight">
        We simulate what happens where biomolecules meet nanomaterials.
      </p>
    </div>
    <div class="md:col-span-5">
      <p class="text-lg leading-relaxed text-muted">
        We are a computational biophysics group at Universidad de Talca, Chile. With molecular dynamics we study peptides, lipids and proteins on nanoparticles and surfaces, and use what we learn to help design materials for medicine and the environment.
      </p>
      <p class="mt-5 flex flex-wrap gap-3">
        <a href="/research" class="btn">Our research</a>
        <a href="/team" class="btn btn-quiet">Meet the team</a>
      </p>
    </div>
  </section>

  <!-- Research: renders on the dark lattice band. -->
  <section class="lattice panel mx-2 md:mx-4 py-16 md:py-24">
    <div class="page">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="h-section">What we work on</h2>
        <a href="/research" class="underline text-leaf hover:text-white">All research lines</a>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-12">
        <a href={`/research#${lead.id}`} class="tile soft rise md:col-span-7 md:row-span-2 min-h-[26rem]">
          <img src={lead.image} alt={lead.alt} loading="lazy" />
          <div>
            <h3 class="text-2xl md:text-4xl font-medium tracking-tight leading-[1.1] max-w-[16ch]">{lead.title}</h3>
            <p class="mt-3 text-white/80 leading-relaxed max-w-[44ch]">{lead.teaser}</p>
          </div>
        </a>

        {rest.filter((line) => line.image && !line.light).map((line) => (
          <a href={`/research#${line.id}`} class="tile soft rise md:col-span-5 min-h-[17rem]">
            <img src={line.image} alt={line.alt} loading="lazy" />
            <div>
              <h3 class="text-xl md:text-2xl font-medium tracking-tight leading-tight max-w-[20ch]">{line.title}</h3>
              <p class="mt-2 text-white/80 leading-snug max-w-[40ch]">{line.teaser}</p>
            </div>
          </a>
        ))}
      </div>

      {/* Lines whose figure has a white background get a split tile. */}
      {rest.filter((line) => line.light).map((line) => (
        <a href={`/research#${line.id}`} class="group soft rise mt-5 grid md:grid-cols-12 overflow-hidden bg-white/[0.06] hover:bg-white/[0.1] transition-colors duration-500">
          <div class="md:col-span-5 p-7 md:p-9 self-center">
            <h3 class="text-xl md:text-2xl font-medium tracking-tight leading-tight group-hover:text-leaf transition-colors duration-300">{line.title}</h3>
            <p class="mt-2 text-white/75 leading-snug max-w-[40ch]">{line.teaser}</p>
          </div>
          <div class="md:col-span-7 bg-white p-4 md:p-6 flex items-center justify-center">
            <img src={line.image} alt={line.alt} loading="lazy" class="w-full h-auto max-h-64 object-contain" />
          </div>
        </a>
      ))}
    </div>
  </section>

  {latest.length > 0 && (
    <section class="page py-16 md:py-24">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="h-section">Recent publications</h2>
        <a href="/publications" class="link">All publications</a>
      </div>

      <ol class="mt-10 grid gap-5 md:grid-cols-2">
        {latest.map((pub) => (
          <li class="rise">
            <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener noreferrer" class="lift soft block h-full bg-wash hover:bg-white p-6 md:p-7">
            <p class="text-accent font-medium"><em>{pub.journal}</em>, {pub.year}</p>
            <h3 class="mt-1 text-xl font-medium leading-snug">{pub.title}</h3>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}

  <!-- Join: the render overlaps the edge of the band. -->
  <section class="panel mx-2 md:mx-4 bg-gradient-to-br from-wash to-white">
    <div class="page grid md:grid-cols-12 gap-x-12 items-center">
      <div class="md:col-span-6 py-16 md:py-24">
        <h2 class="h-section">Work with us</h2>
        <p class="mt-4 text-lg leading-relaxed text-muted max-w-[46ch]">
          Most of our students come through the doctoral program in Modeling of Chemical and Biological Systems at Universidad de Talca. If you want to do a thesis, a research stay or a collaboration on molecular simulation of bio-nano interfaces, write to Horacio.
        </p>
        <p class="mt-6"><a href="mailto:hopoblete@utalca.cl" class="btn">hopoblete@utalca.cl</a></p>
      </div>
      <img
        src="/images/nanoparticle-membrane.webp"
        alt=""
        loading="lazy"
        class="rise md:col-span-6 w-[120%] max-w-none md:-mr-24 max-md:-mt-6 max-md:pb-10"
      />
    </div>
  </section>

  <section class="page py-16 md:py-24 grid md:grid-cols-12 gap-x-12 gap-y-8">
    <h2 class="h-section md:col-span-4">Funding</h2>

    <div class="md:col-span-8">
      {funding.current.map((item) => (
        <div class="soft bg-wash p-7 md:p-9">
          <p class="text-2xl md:text-3xl font-medium tracking-tight text-accent">{item.grant}</p>
          <p class="mt-1 text-muted">Project No. {item.number}, {item.agency}</p>
          <p class="text-muted">{item.role}</p>
        </div>
      ))}

      <details class="mt-8">
        <summary class="cursor-pointer text-muted hover:text-ink transition-colors pl-2">Past funding</summary>
        <ul class="mt-4 border-t border-line">
          {funding.past.map((item) => (
            <li class="py-4 border-b border-line">
              <p><span class="font-medium">{item.grant}</span> <span class="text-muted">({item.years})</span></p>
              <p class="text-muted">{item.role}</p>
              {item.project && <p class="mt-1 text-muted italic">{item.project}</p>}
            </li>
          ))}
        </ul>
      </details>
    </div>
  </section>

</Layout>

<style>
  .hero {
    container-type: inline-size;
  }
  /* Full width at its natural proportions, but never taller than about half the
     window, so the summary below stays in the first screen. */
  .hero-image {
    display: block;
    width: 100%;
    aspect-ratio: 2400 / 1154;
    max-height: 58svh;
    object-fit: cover;
    object-position: center 42%;
  }
  @media (max-width: 47.99rem) {
    .hero-image { aspect-ratio: 3 / 2; max-height: none; }
  }
  /* The floor of the render dissolves into the page instead of ending on a hard edge. */
  .hero-fade {
    position: absolute;
    inset: auto 0 0 0;
    height: 12%;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0), white);
    pointer-events: none;
  }
  /* The name settles in once, on load. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-title { animation: settle 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  }
  @keyframes settle {
    from { opacity: 0; translate: 0 0.8cqw; }
    to { opacity: 1; translate: 0 0; }
  }
  /* Centred on the gap between the two nanoparticles (about 54% across). */
  .hero-title {
    position: absolute;
    top: 6%;
    left: 54.5%;
    transform: translateX(-50%);
    width: 30cqw;
    text-align: center;
    color: var(--color-ink);
  }
  .hero-title h1 {
    font-size: 3.7cqw;
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .hero-title p {
    margin-top: 0.9cqw;
    font-size: 1.3cqw;
    font-weight: 500;
  }

  /* Research tile: render as background, text over a dark gradient. */
  .tile {
    position: relative;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #232d36;
    color: white;
  }
  .tile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tile:hover img {
    transform: scale(1.04);
  }
  .tile > div {
    position: relative;
    width: 100%;
    padding: 5rem 1.75rem 1.75rem;
    background: linear-gradient(to top, rgb(15 20 25 / 0.92) 35%, rgb(15 20 25 / 0));
  }
  @media (prefers-reduced-motion: reduce) {
    .tile img { transition: none; }
  }
</style>
