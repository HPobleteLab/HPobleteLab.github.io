---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import HomeResearch from '../components/sections/HomeResearch.astro';
import HomeFunding from '../components/sections/HomeFunding.astro';

---

<Layout title="HPoblete Lab - Bio-nanomaterial Simulations">
  
  <section id="hero" class="reveal relative min-h-screen flex flex-col justify-center w-full bg-white dark:bg-transparent transition-colors duration-300 pt-24 pb-32">
    <div class="max-w-7xl mx-auto px-6 w-full flex flex-col md:flex-row items-center gap-12 lg:gap-20">
      <div class="md:w-1/2 z-10">
        <span class="text-xs font-bold tracking-widest text-orange-600 dark:text-lab-orange uppercase mb-4 block">
          Universidad de Talca
        </span>
        <h1 class="text-5xl md:text-6xl font-extrabold text-lab-dark dark:text-gray-100 tracking-tight mb-6 leading-tight">
          HPoblete Lab
        </h1>
        <p class="text-2xl text-gray-600 dark:text-gray-400 mb-10 leading-relaxed border-l-4 border-lab-blue pl-6">
          Bio-nanomaterial Simulations Group focused on theoretical and computational biophysics, specializing in protein adsorption on nanosurfaces.
        </p>
      </div>

      <div class="md:w-1/2 w-full">
        <div class="relative">
          <div class="absolute inset-0 bg-orange-600 dark:bg-lab-orange translate-x-3 translate-y-3 -z-10 opacity-100 dark:opacity-80 rounded-sm shadow-lg"></div>
          <img 
            src="/images/hero-bg.jpg" 
            alt="Molecular Simulation" 
            class="w-full h-100 md:h-125 object-cover border border-gray-200 dark:border-[#1E293B] z-10 bg-white dark:bg-[#0F172A] p-2 rounded-sm shadow-md transition-colors" 
          />
        </div>
      </div>
    </div>

    <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 flex flex-col items-center opacity-70 hover:opacity-100 transition-opacity animate-bounce">
      <span class="text-[9px] uppercase tracking-[0.2em] mb-2 font-bold text-gray-400 dark:text-gray-500">Scroll</span>
      <a href="#research" aria-label="Scroll to Research" class="text-gray-400 dark:text-gray-500 hover:text-orange-600 dark:hover:text-lab-orange transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </a>
    </div>
  </section>

  <div class="flex flex-col w-full">
    
    <HomeResearch />

    <HomeFunding />

  </div>
</Layout>