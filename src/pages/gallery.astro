---
// src/pages/gallery.astro
// Entries are edited in src/data/gallery.json. Delete one and it leaves the page;
// the layout alternates automatically, so the order is the only thing to keep in mind.
import Layout from '../layouts/Layout.astro';
import gallery from '../data/gallery.json';

interface Figure {
  image: string;
  thumb?: string;
  title: string;
  alt: string;
  note?: string;
  description: string;
  relatedId?: string;
  relatedLabel?: string;
  plate?: 'light';
  wide?: boolean;
}

const figures = gallery as Figure[];
---

<Layout
  title="Gallery | HPoblete Lab"
  description="Renders from the HPoblete Lab at Universidad de Talca: the systems we simulate, and what each picture is showing."
>
  <section class="lattice panel mx-2 md:mx-4">
    <div class="page py-16 md:py-24">
      <h1 class="text-4xl md:text-6xl font-medium tracking-tight">Gallery</h1>
      <p class="mt-6 text-xl md:text-2xl leading-snug text-white/75 max-w-[52ch]">
        The systems we simulate, rendered. Each one comes with what it is showing, which is the part a picture on its own never tells you.
      </p>
    </div>
  </section>

  <div class="page pb-14 md:pb-20">
    {figures.map((fig, i) => (
      <figure class="rise grid md:grid-cols-12 gap-x-12 gap-y-6 items-center py-10 md:py-16 border-b border-line last:border-0">

        {/* On reversed rows both cells need an explicit column, or the image
            overlaps the caption's last column and is pushed onto a second row.
            Tailwind only emits classes it can see written out, hence the pairs. */}
        <a
          href={fig.image}
          class:list={[
            'block group',
            fig.wide ? 'md:col-span-7' : 'md:col-span-6',
            i % 2 === 1 && 'md:order-2 md:row-start-1',
            i % 2 === 1 && (fig.wide ? 'md:col-start-6' : 'md:col-start-7'),
          ]}
        >
          {/* A portrait render at full column width would be two screens tall and
              leave the caption stranded, so height is capped and the image centred;
              wide ones are still limited by the column instead. */}
          <span
            class:list={[
              'flex justify-center overflow-hidden rounded-2xl',
              fig.plate === 'light' ? 'bg-gradient-to-br from-wash to-white p-4 md:p-6' : '',
            ]}
          >
            <img
              src={fig.thumb ?? fig.image}
              alt={fig.alt}
              loading={i < 2 ? 'eager' : 'lazy'}
              decoding="async"
              class:list={[
                'w-auto max-w-full max-h-[32rem] transition-transform duration-700 group-hover:scale-[1.02]',
                fig.plate === 'light' ? '' : 'rounded-2xl',
              ]}
            />
          </span>
        </a>

        <figcaption
          class:list={[
            fig.wide ? 'md:col-span-5' : 'md:col-span-6',
            i % 2 === 1 && 'md:order-1 md:col-start-1 md:row-start-1',
          ]}
        >
          <h2 class="text-2xl md:text-3xl font-medium tracking-tight">{fig.title}</h2>

          {/* Only the figures that are not a result carry a note, so the marker
              means something wherever it appears instead of labelling everything. */}
          {fig.note && (
            <p class="mt-3 inline-block rounded-full bg-wash px-3 py-1 text-[0.85rem] text-muted ring-1 ring-line">
              {fig.note}
            </p>
          )}

          <p class="mt-4 text-lg leading-relaxed text-muted max-w-[46ch]">{fig.description}</p>

          <p class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-[0.95rem]">
            {fig.relatedId && (
              <a href={`/research#${fig.relatedId}`} class="text-accent hover:text-ink transition-colors duration-300">
                {fig.relatedLabel ?? 'Related research'}
              </a>
            )}
            <a
              href={fig.image}
              class="text-muted hover:text-ink transition-colors duration-300"
            >Full resolution</a>
          </p>
        </figcaption>

      </figure>
    ))}
  </div>

  <section class="panel mx-2 md:mx-4 mb-12 md:mb-20 bg-wash">
    <div class="page py-12 md:py-16">
      <h2 class="h-section">Using these</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted max-w-[62ch]">
        The renders are made in the group and are not released under the licence that covers our code. Reuse in a talk, a class or a paper is welcome, with credit to the HPoblete Lab, Universidad de Talca and a note of where it came from. For anything else, or if you want a version at a different size, crop or palette, write to Horacio and we will make it.
      </p>
      <p class="mt-6"><a href="mailto:hopoblete@utalca.cl" class="btn">hopoblete@utalca.cl</a></p>
    </div>
  </section>
</Layout>
