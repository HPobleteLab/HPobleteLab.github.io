---
// src/pages/resources.astro
// Entries are edited in src/data/resources.json.
import Layout from '../layouts/Layout.astro';
import resources from '../data/resources.json';

interface Resource {
  name: string;
  repo: string;
  owner: string;
  summary: string;
  detail?: string;
  stack?: string;
  people?: string;
}

const items = resources as Resource[];
---

<Layout
  title="Resources | HPoblete Lab"
  description="Code released by the HPoblete Lab at Universidad de Talca: analysis scripts and modelling tools, free to use."
>
  <section class="lattice panel mx-2 md:mx-4">
    <div class="page py-16 md:py-24">
      <h1 class="text-4xl md:text-6xl font-medium tracking-tight">Resources</h1>
      <p class="mt-6 text-xl md:text-2xl leading-snug text-white/75 max-w-[50ch]">
        The tools we write for our own work, released so that nobody has to write them twice.
      </p>
    </div>
  </section>

  <div class="page py-14 md:py-20 grid gap-6 md:grid-cols-2">
    {items.map((item) => (
      <article class="rise soft lift bg-wash hover:bg-white p-7 md:p-9 flex flex-col">
        <h2 class="text-2xl md:text-3xl font-medium tracking-tight">
          <a href={item.repo} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors duration-300">{item.name}</a>
        </h2>
        <p class="mt-1 text-muted">{item.owner}</p>

        <p class="mt-5 text-lg leading-relaxed">{item.summary}</p>
        {item.detail && <p class="mt-3 leading-relaxed text-muted">{item.detail}</p>}

        <dl class="mt-6 text-[0.95rem]">
          {item.stack && (
            <div class="flex gap-3">
              <dt class="text-muted shrink-0">Built with</dt>
              <dd>{item.stack}</dd>
            </div>
          )}
          {item.people && (
            <div class="flex gap-3 mt-1">
              <dt class="text-muted shrink-0">Written by</dt>
              <dd>{item.people}</dd>
            </div>
          )}
        </dl>

        <p class="mt-auto pt-7">
          <a href={item.repo} target="_blank" rel="noopener noreferrer" class="btn">View on GitHub</a>
        </p>
      </article>
    ))}
  </div>
</Layout>
