---
// src/pages/resources.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Badge from '../components/core/Badge.astro';

const allResources = await getCollection('resources');
const getActionDetails = (type: string) => {
  switch (type) {
    case 'github':
      return { text: "View Repository", icon: "github" };
    case 'pdf':
      return { text: "Download PDF", icon: "pdf" };
    case 'download':
      return { text: "Download Resource", icon: "download" };
    default:
      return { text: "Access Link", icon: "link" };
  }
};
---

<Layout title="Resources | HPoblete Lab">
  <main class="bg-slate-100 dark:bg-[#0B1121] min-h-screen transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-6 pt-24 pb-24 md:pt-32">
      
      <div class="reveal mb-12 border-b border-gray-200 dark:border-[#1E293B] pb-8">
        <h1 class="text-5xl md:text-6xl font-bold text-lab-dark dark:text-gray-100 border-l-4 border-lab-red pl-4">
          Resources
        </h1>
        <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-400 mt-6 leading-relaxed font-light max-w-4xl">
          A collection of tutorials, scripts, and computational tools developed by our group to support the biophysics and simulation community.
        </p>
      </div>

      <div class="reveal flex flex-wrap justify-center md:justify-start items-center gap-x-4 md:gap-x-8 gap-y-4 mb-12 border-b border-gray-200 dark:border-[#1E293B] pb-2">
        <button class="filter-btn text-[clamp(11px,1.5vw,16px)] font-bold uppercase tracking-widest text-orange-600 dark:text-lab-orange border-b-2 border-orange-600 dark:border-lab-orange pb-2 transition-colors" data-filter="all">
          Show All
        </button>
        <button class="filter-btn text-[clamp(11px,1.5vw,16px)] font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500 hover:text-lab-dark dark:hover:text-gray-300 border-b-2 border-transparent pb-2 transition-colors" data-filter="Tutorial">
          Tutorials
        </button>
        <button class="filter-btn text-[clamp(11px,1.5vw,16px)] font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500 hover:text-lab-dark dark:hover:text-gray-300 border-b-2 border-transparent pb-2 transition-colors" data-filter="Tool">
          Tools
        </button>
      </div>

      <div class="relative min-h-100">
        
        <div id="resource-loader" class="absolute inset-0 flex flex-col items-center justify-center bg-slate-100/80 dark:bg-[#0B1121]/80 z-30 opacity-0 transition-opacity duration-300">
          <div class="w-12 h-12 border-4 border-gray-300 dark:border-gray-700 border-t-orange-600 dark:border-t-lab-orange rounded-full animate-spin mb-4"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="resources-container">
          {allResources.map((resource, index) => {
            const action = getActionDetails(resource.data.actionType);
            
            return (
              <article 
                class="resource-card flex flex-col bg-white dark:bg-[#0F172A] p-8 border border-gray-200 dark:border-[#1E293B] shadow-sm hover:shadow-xl hover:-translate-y-1! transition-all duration-300 rounded-sm transform origin-center opacity-0"
                data-category={resource.data.category}
                style={`animation: popInFromBottom 0.5s cubic-bezier(0.16, 1, 0.3, 1) ${index * 0.05}s forwards;`}
              >
                <div class="mb-4">
                  <Badge text={resource.data.category} color={resource.data.category === 'Tutorial' ? 'blue' : 'orange'} />
                </div>

                <h3 class="text-2xl font-bold text-lab-dark dark:text-gray-100 mb-4 leading-tight">
                  {resource.data.title}
                </h3>

                <p class="text-base text-gray-600 dark:text-gray-400 mb-8 grow leading-relaxed">
                  {resource.data.description}
                </p>

                <div class="mt-auto pt-6 border-t border-gray-100 dark:border-[#1E293B]">
                  <a href={resource.data.link} target="_blank" class="group inline-flex items-center gap-3 text-sm font-bold uppercase tracking-widest text-lab-blue dark:text-blue-400 hover:text-orange-600 dark:hover:text-lab-orange transition-colors">
                    
                    {/* ICONOS DINÁMICOS */}
                    {action.icon === 'github' && (
                      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                    )}
                    {action.icon === 'pdf' && (
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                    )}
                    {action.icon === 'download' && (
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                    )}
                    {action.icon === 'link' && (
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                    )}
                    
                    {/* TEXTO DEL BOTÓN */}
                    {action.text}
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </div>

    </div>
  </main>
</Layout>

<style is:global>
  @keyframes popInFromBottom {
    0% { opacity: 0; transform: translateY(40px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  
  @keyframes shrinkToCenter {
    0% { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: scale(0.9); }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.resource-card') as NodeListOf<HTMLElement>;
    const loader = document.getElementById('resource-loader');
    
    let isAnimating = false;

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (isAnimating) return;
        
        const filter = btn.getAttribute('data-filter');
        
        // Comprobar si el botón ya está activo
        const activeBtn = document.querySelector('.filter-btn.text-orange-600, .filter-btn.dark\\:text-lab-orange');
        if (activeBtn && activeBtn.getAttribute('data-filter') === filter) return;

        isAnimating = true;

        // 1. Cambiar colores del menú
        filterBtns.forEach(b => {
          b.classList.remove('text-orange-600', 'dark:text-lab-orange', 'border-orange-600', 'dark:border-lab-orange');
          b.classList.add('text-gray-400', 'dark:text-gray-500', 'border-transparent');
        });

        btn.classList.remove('text-gray-400', 'dark:text-gray-500', 'border-transparent');
        btn.classList.add('text-orange-600', 'dark:text-lab-orange', 'border-orange-600', 'dark:border-lab-orange');

        let cardsToHide: HTMLElement[] = [];
        let cardsToShow: HTMLElement[] = [];

        // 2. Clasificar las tarjetas
        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          const isMatch = filter === 'all' || category === filter;
          const isVisible = card.style.display !== 'none';

          if (!isMatch && isVisible) cardsToHide.push(card);
          if (isMatch) cardsToShow.push(card);
        });

        // 3. Ocultar las tarjetas que no coinciden
        cardsToHide.forEach(card => {
          card.style.animation = 'none';
          void card.offsetWidth;
          card.style.animation = 'shrinkToCenter 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards';
        });

        const delayToLoad = cardsToHide.length > 0 ? 300 : 0;

        setTimeout(() => {
          // Limpiar el área
          cards.forEach(card => {
            card.style.display = 'none';
            card.style.animation = 'none';
          });

          // Mostrar Spinner
          if (loader) {
            loader.classList.remove('hidden');
            setTimeout(() => loader.classList.remove('opacity-0'), 10);
          }

          setTimeout(() => {
            // Ocultar Spinner
            if (loader) {
              loader.classList.add('opacity-0');
              setTimeout(() => loader.classList.add('hidden'), 300);
            }

            // Mostrar tarjetas correspondientes
            cardsToShow.forEach((card, index) => {
              card.style.display = 'flex'; // Importante para mantener la estructura flex
              card.style.animation = 'none';
              void card.offsetWidth; 
              
              card.style.animation = `popInFromBottom 0.5s cubic-bezier(0.16, 1, 0.3, 1) ${index * 0.05}s forwards`;
            });

            setTimeout(() => {
              isAnimating = false;
            }, 500 + (cardsToShow.length * 50));

          }, 600); // Tiempo del spinner

        }, delayToLoad);

      });
    });
  });
</script>