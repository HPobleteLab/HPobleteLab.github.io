---
// src/pages/publications.astro
// The list comes from src/data/publications.json, refreshed with `npm run update-pubs`.
import Layout from '../layouts/Layout.astro';
import publications from '../data/publications.json';
import { highlightAuthor } from '../utils/textFormatters';

interface Publication {
  id: string;
  title: string;
  authors: string[];
  journal: string | null;
  year: number;
  volume: string | null;
  pages: string | null;
  doi: string | null;
}

const pubs = publications as Publication[];
const years = [...new Set(pubs.map((pub) => pub.year))].sort((a, b) => b - a);

const SCHOLAR_URL = 'https://scholar.google.com/citations?user=feuxRSEAAAAJ&hl=en';
---

<Layout title="Publications | HPoblete Lab">
  <div class="page pt-12 md:pt-16">
    <h1 class="text-4xl md:text-5xl font-medium tracking-tight">Publications</h1>

    {pubs.length === 0 ? (
      <p class="mt-6 text-lg md:text-xl leading-relaxed text-muted max-w-[58ch]">
        The list is being updated. The full record is on
        <a href={SCHOLAR_URL} target="_blank" rel="noopener noreferrer" class="link">Google Scholar</a>.
      </p>
    ) : (
      <>
        <p class="mt-6 text-lg text-muted">
          {pubs.length} publications, also listed on
          <a href={SCHOLAR_URL} target="_blank" rel="noopener noreferrer" class="link">Google Scholar</a>.
        </p>

        <div class="mt-12 border-t border-line">
          {years.map((year) => (
            <section class="py-8 border-b border-line grid md:grid-cols-12 gap-x-12 gap-y-4">
              <h2 class="md:col-span-2 text-3xl font-medium tracking-tight text-muted/60 tabular-nums">{year}</h2>
              <ol class="md:col-span-10 space-y-7">
                {pubs.filter((pub) => pub.year === year).map((pub) => (
                  <li class="max-w-[75ch]">
                    <h3 class="text-lg font-medium leading-snug">
                      {pub.doi
                        ? <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener noreferrer" class="hover:underline">{pub.title}</a>
                        : pub.title}
                    </h3>
                    <p class="mt-1 text-muted leading-relaxed" set:html={highlightAuthor(pub.authors.join(', '))} />
                    <p class="text-muted">
                      {pub.journal && <em>{pub.journal}</em>}{pub.volume && <>, <strong class="font-medium">{pub.volume}</strong></>}{pub.pages && `, ${pub.pages}`}
                    </p>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      </>
    )}
  </div>
</Layout>
