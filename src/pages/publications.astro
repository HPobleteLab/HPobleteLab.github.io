---
// src/pages/publications.astro
// The list comes from src/data/publications.json, refreshed with `npm run update-pubs`.
import Layout from '../layouts/Layout.astro';
import publications from '../data/publications.json';
import { highlightAuthor } from '../utils/textFormatters';

interface Publication {
  id: string;
  title: string;
  authors: string[];
  journal: string | null;
  year: number;
  volume: string | null;
  pages: string | null;
  doi: string | null;
}

const pubs = publications as Publication[];
const years = [...new Set(pubs.map((pub) => pub.year))].sort((a, b) => b - a);

const SCHOLAR_URL = 'https://scholar.google.com/citations?user=feuxRSEAAAAJ&hl=en';

const filterClass = "filter-btn text-[clamp(11px,1.5vw,16px)] font-bold uppercase tracking-widest pb-2 border-b-2 transition-colors border-transparent text-gray-400 dark:text-gray-500 hover:text-lab-dark dark:hover:text-gray-300 aria-pressed:border-orange-600 aria-pressed:text-orange-600 dark:aria-pressed:border-lab-orange dark:aria-pressed:text-lab-orange";
---

<Layout title="Publications | HPoblete Lab">
  <div class="bg-slate-100 dark:bg-[#0B1121] min-h-screen transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-6 pt-24 pb-24 md:pt-32">

      <div class="reveal flex flex-col lg:flex-row justify-between items-start lg:items-center mb-16 border-b border-gray-200 dark:border-[#1E293B] pb-10 gap-8">
        <h1 class="text-5xl md:text-6xl font-bold text-lab-dark dark:text-gray-100 border-l-4 border-lab-red pl-4">
          Publications
        </h1>

        <a href={SCHOLAR_URL} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-3 bg-orange-600 hover:bg-orange-700 dark:bg-lab-orange dark:hover:bg-orange-500 text-white px-8 py-4 text-base md:text-lg font-bold shadow-lg transition-colors rounded-sm w-full md:w-auto shrink-0">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z"/>
          </svg>
          Google Scholar Profile
        </a>
      </div>

      {pubs.length === 0 ? (
        <p class="text-xl text-gray-600 dark:text-gray-400 max-w-3xl leading-relaxed">
          The publication list is being updated. In the meantime, the full record is available on
          <a href={SCHOLAR_URL} target="_blank" rel="noopener noreferrer" class="text-lab-blue dark:text-blue-400 underline">Google Scholar</a>.
        </p>
      ) : (
        <>
          <div class="flex flex-wrap justify-center md:justify-start items-center gap-x-4 md:gap-x-8 gap-y-4 mb-12 border-b border-gray-200 dark:border-[#1E293B] pb-2" role="group" aria-label="Filter by year">
            <button type="button" class={filterClass} data-filter="all" aria-pressed="true">Show All</button>
            {years.map((year) => (
              <button type="button" class={filterClass} data-filter={String(year)} aria-pressed="false">{year}</button>
            ))}
          </div>

          <ol class="flex flex-col gap-5">
            {pubs.map((pub) => (
              <li class="pub-card bg-white dark:bg-[#0F172A] p-6 md:p-8 border border-gray-200 dark:border-[#1E293B] shadow-sm rounded-sm" data-year={pub.year}>
                <span class="text-xs md:text-sm font-bold text-orange-600 dark:text-lab-orange tracking-widest">{pub.year}</span>

                <h2 class="text-xl md:text-2xl font-bold text-lab-blue dark:text-blue-400 mt-2 mb-2 leading-snug">
                  {pub.title}
                </h2>

                <p class="text-sm md:text-base text-gray-700 dark:text-gray-300 mb-3 leading-relaxed font-light" set:html={highlightAuthor(pub.authors.join(', '))} />

                <p class="text-sm text-gray-500 dark:text-gray-400">
                  {pub.journal && <em>{pub.journal}</em>}{pub.volume && <>, <strong>{pub.volume}</strong></>}{pub.pages && `, ${pub.pages}`}
                  {pub.doi && (
                    <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener noreferrer" class="block mt-2 font-mono text-xs text-lab-blue dark:text-blue-400 hover:underline break-all">
                      doi:{pub.doi}
                    </a>
                  )}
                </p>
              </li>
            ))}
          </ol>
        </>
      )}

    </div>
  </div>
</Layout>

<script>
  // Year filter: toggles visibility instantly, no animation or fake loading state.
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.pub-card');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      cards.forEach((card) => {
        card.hidden = filter !== 'all' && card.dataset.year !== filter;
      });
    });
  });
</script>
