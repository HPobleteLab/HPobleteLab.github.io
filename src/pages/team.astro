---
// src/pages/team.astro
// Members are edited in src/content/team/ (one JSON file per person).
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import TeamMember from '../components/sections/TeamMember.astro';
import { groupTeamByCategory, memberLinks } from '../utils/collections';

const team = groupTeamByCategory(await getCollection('team'));
const { pi, alumni } = team;

const groups = [
  { title: 'Postdoctoral researchers', members: team.postdocs },
  { title: 'PhD students', members: team.phdStudents },
  { title: 'Research assistants', members: team.researchAssistants },
  { title: 'Undergraduate students', members: team.undergraduateStudents },
].filter((group) => group.members.length > 0);
---

<Layout title="Team | HPoblete Lab">
  {pi && (
    <section class="panel mx-2 md:mx-4 mt-2 bg-gradient-to-br from-wash to-white">
      <div class="page py-14 md:py-20 grid md:grid-cols-12 gap-x-12 gap-y-8 items-center">
        <div class="md:col-span-8">
          <h1 class="text-muted">Team</h1>
          <h2 class="mt-2 text-4xl md:text-6xl font-medium tracking-tight">{pi.data.name}</h2>
          <p class="mt-3 text-xl text-accent">Principal Investigator</p>
          {pi.data.bio && <p class="mt-6 text-lg leading-relaxed max-w-[62ch]">{pi.data.bio}</p>}
          <p class="mt-6 flex flex-wrap gap-3">
            {memberLinks(pi.data).map(({ label, href }) => (
              <a href={href} target={href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener noreferrer" class="btn btn-quiet bg-white">{label}</a>
            ))}
          </p>
        </div>
        {pi.data.image && (
          <img src={pi.data.image} alt={pi.data.name} class="soft md:col-span-4 w-full max-w-xs md:max-w-none aspect-[4/5] object-cover" />
        )}
      </div>
    </section>
  )}

  <div class="page">
    {groups.map((group) => (
      <section class="py-12">
        <h2 class="h-section">{group.title}</h2>
        <div class="mt-10 grid gap-x-12 gap-y-10 md:grid-cols-2">
          {group.members.map((member) => <TeamMember member={member} />)}
        </div>
      </section>
    ))}

    {alumni.length > 0 && (
      <section class="py-12">
        <h2 class="h-section">Former members</h2>
        <ul class="mt-8 grid gap-x-12 gap-y-6 md:grid-cols-2">
          {alumni.map((member) => (
            <li>
              <p class="font-medium text-lg">{member.data.name}</p>
              <p class="text-muted">{member.data.role}</p>
              {member.data.bio && <p class="mt-1 text-muted leading-relaxed">{member.data.bio}</p>}
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Layout>
