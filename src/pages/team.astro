---
// src/pages/team.astro
// Members are edited in src/content/team/ (one JSON file per person).
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import TeamMember from '../components/sections/TeamMember.astro';
import { groupTeamByCategory, memberLinks } from '../utils/collections';

const team = groupTeamByCategory(await getCollection('team'));
const { pi, alumni } = team;

const groups = [
  { title: 'Postdoctoral researchers', members: team.postdocs },
  { title: 'PhD students', members: team.phdStudents },
  { title: 'Research assistants', members: team.researchAssistants },
  { title: 'Undergraduate students', members: team.undergraduateStudents },
].filter((group) => group.members.length > 0);
---

<Layout title="Team | HPoblete Lab">
  <div class="page pt-12 md:pt-16">
    <h1 class="text-4xl md:text-5xl font-medium tracking-tight">Team</h1>

    {pi && (
      <section class="mt-12 md:mt-16 grid md:grid-cols-12 gap-x-12 gap-y-8 items-start">
        {pi.data.image && (
          <img src={pi.data.image} alt={pi.data.name} class="md:col-span-4 w-full max-w-sm aspect-[4/5] object-cover bg-wash" />
        )}
        <div class="md:col-span-8">
          <h2 class="text-3xl font-medium tracking-tight">{pi.data.name}</h2>
          <p class="mt-1 text-lg text-muted">Principal Investigator, {pi.data.role}</p>
          {pi.data.bio && <p class="mt-6 text-lg leading-relaxed max-w-[62ch]">{pi.data.bio}</p>}
          <p class="mt-6 flex flex-wrap gap-x-6 gap-y-1">
            {memberLinks(pi.data).map(({ label, href }) => (
              <a href={href} target={href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener noreferrer" class="link">{label}</a>
            ))}
          </p>
        </div>
      </section>
    )}

    {groups.map((group) => (
      <section class="mt-20">
        <h2 class="text-2xl font-medium tracking-tight pb-4 border-b border-line">{group.title}</h2>
        <div class="mt-8 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-8 gap-y-12">
          {group.members.map((member) => <TeamMember member={member} />)}
        </div>
      </section>
    ))}

    {alumni.length > 0 && (
      <section class="mt-20">
        <h2 class="text-2xl font-medium tracking-tight pb-4 border-b border-line">Former members</h2>
        <ul>
          {alumni.map((member) => (
            <li class="py-3 border-b border-line flex flex-wrap justify-between gap-x-8">
              <span class="font-medium">{member.data.name}</span>
              <span class="text-muted">{member.data.role}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Layout>
