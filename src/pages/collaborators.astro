---
// src/pages/collaborators.astro
// Collaborators are edited in src/data/collaborators.json. Joint papers are not
// listed by hand: each entry's `match` names are looked up in the publication list.
import Layout from '../layouts/Layout.astro';
import collaborators from '../data/collaborators.json';
import publications from '../data/publications.json';

interface Collaborator {
  name: string;
  position: string;
  affiliation: string;
  place: string;
  note: string;
  link?: string;
  linkLabel?: string;
  match: string[];
}

interface Publication {
  title: string;
  authors: string[];
  journal: string | null;
  year: number;
  doi: string | null;
}

const pubs = publications as Publication[];

const jointPapers = (match: string[]) =>
  pubs.filter((pub) =>
    pub.authors.some((author) => match.some((name) => author.toLowerCase().includes(name.toLowerCase()))),
  );

// Showing every joint paper would bury the shorter entries, so each one lists
// the three most recent and counts the rest.
const SHOWN = 3;

const people = (collaborators as Collaborator[]).map((person) => {
  const papers = jointPapers(person.match);
  return { ...person, papers: papers.slice(0, SHOWN), rest: Math.max(papers.length - SHOWN, 0) };
});
---

<Layout
  title="Collaborators | HPoblete Lab"
  description="Researchers who co-supervise theses and share projects with the HPoblete Lab at Universidad de Talca."
>
  <section class="lattice panel mx-2 md:mx-4 mt-2">
    <div class="page py-16 md:py-24">
      <h1 class="text-4xl md:text-6xl font-medium tracking-tight">Collaborators</h1>
      <p class="mt-6 text-xl md:text-2xl leading-snug text-white/75 max-w-[50ch]">
        Simulation answers only half of each question. These researchers co-supervise our theses and bring the experiments, the chemistry and the models we build on.
      </p>
    </div>
  </section>

  <div class="page">
    {people.map((person) => (
      <section class="rise py-12 md:py-14 grid md:grid-cols-12 gap-x-12 gap-y-5">
        <div class="md:col-span-5">
          <h2 class="text-2xl md:text-3xl font-medium tracking-tight">{person.name}</h2>
          <p class="mt-1 text-accent">{person.position}</p>
          <p class="mt-2 text-muted leading-relaxed">{person.affiliation}</p>
          <p class="text-muted">{person.place}</p>
          {person.link && (
            <p class="mt-3">
              <a href={person.link} target="_blank" rel="noopener noreferrer" class="link">{person.linkLabel ?? 'Website'}</a>
            </p>
          )}
        </div>

        <div class="md:col-span-7">
          <p class="text-lg leading-relaxed max-w-[60ch]">{person.note}</p>

          {person.papers.length > 0 && (
            <>
              <h3 class="mt-7 text-muted">Together we published</h3>
              <ul class="mt-3 space-y-2">
                {person.papers.map((paper) => (
                  <li>
                    <a
                      href={paper.doi ? `https://doi.org/${paper.doi}` : '/publications'}
                      target={paper.doi ? '_blank' : undefined}
                      rel="noopener noreferrer"
                      class="lift soft block bg-wash hover:bg-white px-5 py-3.5"
                    >
                      {paper.title}
                      <span class="block text-muted"><em>{paper.journal}</em>, {paper.year}</span>
                    </a>
                  </li>
                ))}
              </ul>
              {person.rest > 0 && (
                <p class="mt-3 text-muted">
                  and {person.rest} more, in <a href="/publications" class="link">the publication list</a>.
                </p>
              )}
            </>
          )}
        </div>
      </section>
    ))}
  </div>
</Layout>
