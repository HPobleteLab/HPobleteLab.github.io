---
// src/components/seo/SEOMeta.astro
interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/images/placeholder.jpg' } = Astro.props;

// Social networks require absolute URLs.
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const ogImage = new URL(image, Astro.site ?? Astro.url.origin).toString();
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
