---
// src/components/core/Badge.astro
interface Props {
  text: string;
  color?: 'blue' | 'orange' | 'gray';
}

const { text, color = 'blue' } = Astro.props;

const colorClasses = {
  blue: 'bg-lab-blue text-white',
  orange: 'bg-orange-600 dark:bg-lab-orange text-white',
  gray: 'bg-slate-200 dark:bg-slate-800 text-lab-dark dark:text-gray-300'
};
---

<span class={`text-[10px] md:text-xs font-bold px-2 py-1 uppercase tracking-widest rounded-sm shadow-sm flex-shrink-0 ${colorClasses[color]}`}>
  {text}
</span>