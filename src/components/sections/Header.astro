---
// src/components/sections/Header.astro
const links = [
  { href: '/research', label: 'Research' },
  { href: '/publications', label: 'Publications' },
  { href: '/team', label: 'Team' },
  { href: '/collaborators', label: 'Collaborators' },
];

// Built pages are served as /team/, so drop the trailing slash before comparing.
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

{/* The header is a floating panel, like the dark bands and the figures below it,
    over a white gradient that veils whatever scrolls past above it. */}
<header class="sticky top-0 z-40 pt-2 md:pt-3 pb-3 bg-gradient-to-b from-white via-white/92 to-transparent">
  <div class="mx-2 md:mx-4 rounded-2xl bg-white/90 backdrop-blur-md ring-1 ring-ink/10 shadow-[0_14px_30px_-22px_rgb(26_35_43/0.55)]">
    <div class="page flex flex-wrap items-center justify-between gap-y-2 py-2.5 md:py-3">

      <a href="/" class="flex items-center gap-3 group">
        <img
          src="/images/logo-128.png"
          alt=""
          width="128"
          height="128"
          class="w-10 h-10 md:w-11 md:h-11 transition-transform duration-500 group-hover:rotate-[30deg]"
        />
        <span class="leading-tight">
          <span class="block text-lg font-semibold tracking-tight group-hover:text-accent transition-colors duration-300">HPoblete Lab</span>
          <span class="hidden sm:block text-[0.78rem] text-muted">Bio-nanomaterial Simulations Group</span>
        </span>
      </a>

      <nav aria-label="Main" class="max-md:w-full">
        <ul class="flex gap-5 sm:gap-7 text-[0.95rem] max-md:text-sm">
          {links.map(({ href, label }) => {
            const active = currentPath === href;
            return (
              <li>
                <a
                  href={href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'relative block py-1 transition-colors duration-300',
                    'after:absolute after:left-0 after:right-0 after:-bottom-0.5 after:h-px after:bg-accent after:transition-transform after:duration-300 after:origin-left',
                    active ? 'text-ink after:scale-x-100' : 'text-muted hover:text-ink after:scale-x-0 hover:after:scale-x-100',
                  ]}
                >{label}</a>
              </li>
            );
          })}
        </ul>
      </nav>

    </div>
  </div>
</header>
