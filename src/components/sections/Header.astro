---
// src/components/sections/Header.astro
const links = [
  { href: '/research', label: 'Research' },
  { href: '/publications', label: 'Publications' },
  { href: '/team', label: 'Team' },
  { href: '/collaborators', label: 'Collaborators' },
];

// Built pages are served as /team/, so drop the trailing slash before comparing.
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-40 bg-white/92 backdrop-blur-md">
  <div class="page flex flex-wrap items-center justify-between gap-y-1 py-4">
    <a href="/" class="flex items-center gap-3 group">
      <img
        src="/images/logo-128.png"
        alt=""
        width="128"
        height="128"
        class="w-9 h-9 md:w-10 md:h-10"
      />
      <span class="text-lg font-semibold tracking-tight group-hover:text-accent transition-colors duration-300">
        HPoblete Lab
      </span>
    </a>

    <nav aria-label="Main" class="max-md:w-full max-md:pb-1">
      <ul class="flex gap-5 sm:gap-7 text-[0.95rem] max-md:text-sm">
        {links.map(({ href, label }) => {
          const active = currentPath === href;
          return (
            <li>
              <a
                href={href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'relative block py-1 transition-colors duration-300',
                  'after:absolute after:left-0 after:right-0 after:-bottom-0.5 after:h-px after:bg-accent after:transition-transform after:duration-300 after:origin-left',
                  active ? 'text-ink after:scale-x-100' : 'text-muted hover:text-ink after:scale-x-0 hover:after:scale-x-100',
                ]}
              >{label}</a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
