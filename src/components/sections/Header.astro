---
// src/components/sections/Header.astro
const links = [
  { href: '/research', label: 'Research' },
  { href: '/publications', label: 'Publications' },
  { href: '/team', label: 'Team' },
];

// Built pages are served as /team/, so drop the trailing slash before comparing.
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="bg-white">
  <div class="page flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 py-5">
    <a href="/" class="text-lg font-semibold tracking-tight">
      HPoblete Lab
      <span class="hidden sm:inline font-normal text-muted"> / Bio-nanomaterial Simulations Group</span>
    </a>

    <nav aria-label="Main">
      <ul class="flex gap-6 sm:gap-8 text-[0.95rem]">
        {links.map(({ href, label }) => {
          const active = currentPath === href;
          return (
            <li>
              <a
                href={href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'pb-1 border-b-2 transition-colors',
                  active ? 'border-accent text-ink font-medium' : 'border-transparent text-muted hover:text-ink',
                ]}
              >{label}</a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
