---
// src/components/sections/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="bg-lab-dark border-t border-[#1E293B] text-white pt-16 pb-8 px-6 w-full mt-auto">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12 items-start mb-12">
    
    <div class="flex flex-col items-center md:items-start text-center md:text-left">
      <h3 class="text-2xl font-bold text-gray-100 mb-2 tracking-tight">HPoblete Lab</h3>
      <p class="text-sm font-light text-gray-400 mb-4 max-w-xs">
        Bio-nanomaterial Simulations Group.
      </p>
      <div class="flex items-center gap-2 text-orange-600 dark:text-lab-orange bg-white/5 py-1.5 px-3 rounded-full">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        <span class="text-[10px] uppercase tracking-widest font-bold text-gray-300">Universidad de Talca, Chile</span>
      </div>
    </div>

    <div class="flex flex-col items-center md:items-center">
      <h4 class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-6">Explore</h4>
      <ul class="flex flex-wrap justify-center md:flex-col md:items-center text-center gap-4 md:gap-3 text-sm text-gray-300 font-medium">
        <li><a href="/" class="hover:text-orange-500 transition-colors">Home</a></li>
        <li><a href="/research" class="hover:text-orange-500 transition-colors">Research Lines</a></li>
        <li><a href="/publications" class="hover:text-orange-500 transition-colors">Publications</a></li>
        <li><a href="/team" class="hover:text-orange-500 transition-colors">Our Team</a></li>
      </ul>
    </div>
    
    <div class="flex flex-col items-center md:items-end">
      <h4 class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-6">Connect</h4>
      <div class="flex items-center gap-6">
        
        <a href="https://x.com/NBMgUtalca" target="_blank" rel="noopener noreferrer" class="p-2 bg-white/5 rounded-full text-gray-400 hover:text-white hover:bg-white/10 transition-all duration-300 hover:-translate-y-1" aria-label="Twitter X">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>

        <a href="https://instagram.com/hpobletelab" target="_blank" rel="noopener noreferrer" class="p-2 bg-white/5 rounded-full text-gray-400 hover:text-lab-orange hover:bg-white/10 transition-all duration-300 hover:-translate-y-1" aria-label="Instagram">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849s-.011 3.584-.069 4.849c-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07s-3.584-.012-4.849-.07c-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849s.012-3.584.07-4.849c.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948s.014 3.667.072 4.947c.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072s3.667-.014 4.947-.072c4.351-.2 6.77-2.618 6.97-6.98.059-1.28.073-1.689.073-4.948s-.014-3.667-.072-4.947c-.2-4.352-2.612-6.77-6.97-6.98-1.281-.058-1.69-.072-4.947-.072zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>

        <a href="https://github.com/HPobleteLab" target="_blank" rel="noopener noreferrer" class="p-2 bg-white/5 rounded-full text-gray-400 hover:text-white hover:bg-white/10 transition-all duration-300 hover:-translate-y-1" aria-label="GitHub">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
          </svg>
        </a>

      </div>
    </div>

  </div>

  <div class="max-w-7xl mx-auto border-t border-white/10 pt-6 flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-light text-gray-500">
    <p>&copy; {currentYear} HPoblete Lab. All rights reserved.</p>
    <p>Designed for Bio-nanomaterial Science</p>
  </div>
</footer>