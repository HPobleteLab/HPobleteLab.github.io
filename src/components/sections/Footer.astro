---
// src/components/sections/Footer.astro
const year = new Date().getFullYear();

const social = [
  { label: 'GitHub', href: 'https://github.com/HPobleteLab' },
  { label: 'X', href: 'https://x.com/NBMgUtalca' },
  { label: 'Instagram', href: 'https://instagram.com/hpobletelab' },
];
---

<footer class="mt-24 border-t border-line">
  <div class="page py-10 flex flex-col md:flex-row md:items-baseline md:justify-between gap-6 text-sm text-muted">
    <p>
      <span class="text-ink font-medium">HPoblete Lab</span><br />
      Bio-nanomaterial Simulations Group<br />
      Universidad de Talca, Chile
    </p>

    <ul class="flex gap-6">
      {social.map(({ label, href }) => (
        <li><a href={href} target="_blank" rel="noopener noreferrer" class="hover:text-ink underline">{label}</a></li>
      ))}
    </ul>

    <p>&copy; {year} HPoblete Lab</p>
  </div>
</footer>
