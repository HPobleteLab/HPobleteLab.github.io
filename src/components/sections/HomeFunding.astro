---
// src/components/sections/HomeFunding.astro
---

<section id="funding" class="scroll-mt-24 reveal relative border-y border-gray-200 dark:border-[#1E293B] min-h-[calc(100vh-6rem)] flex flex-col justify-center py-16 w-full transition-colors duration-300 odd:bg-slate-100 even:bg-white dark:odd:bg-[#0F172A] dark:even:bg-[#080D19]">
  <div class="max-w-7xl mx-auto px-6 w-full">
    <h2 class="text-4xl md:text-5xl font-bold text-lab-dark dark:text-gray-100 mb-16 border-l-4 border-lab-red pl-4">Funding</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
      <div class="bg-slate-100 dark:bg-[#0F172A] p-8 border border-gray-200 dark:border-[#1E293B] border-l-4 border-l-lab-blue dark:border-l-lab-orange shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-300 flex flex-col h-full rounded-sm">
        <span class="text-xs font-bold text-orange-600 dark:text-lab-orange uppercase tracking-widest mb-3 block">2017 – 2021</span>
        <h3 class="text-xl font-bold text-lab-dark dark:text-gray-100 mb-2">Fondecyt Regular 2017</h3>
        <p class="text-sm font-bold text-lab-blue dark:text-blue-400 mb-4">Principal Investigator</p>
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-6 flex-grow leading-relaxed italic">
          "New Insights into conformational equilibria of proteins absorbed to nanometal surfaces using molecular dynamics simulations..."
        </p>
        <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Universidad de Talca</p>
      </div>

      <div class="bg-slate-100 dark:bg-[#0F172A] p-8 border border-gray-200 dark:border-[#1E293B] border-l-4 border-l-lab-blue dark:border-l-lab-orange shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-300 flex flex-col h-full rounded-sm">
        <span class="text-xs font-bold text-orange-600 dark:text-lab-orange uppercase tracking-widest mb-3 block">2018 – 2021</span>
        <h3 class="text-xl font-bold text-lab-dark dark:text-gray-100 mb-2">Fondecyt Regular 2018</h3>
        <p class="text-sm font-bold text-lab-blue dark:text-blue-400 mb-4">Co-Investigator <span class="text-gray-500 font-normal">(PI: Jans Alzate-Morales)</span></p>
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-6 flex-grow leading-relaxed italic">
          "Estimating residence time in protein-ligand complexes: New computational tools for understanding pharmacological effects..."
        </p>
        <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Universidad de Talca</p>
      </div>

      <div class="bg-slate-100 dark:bg-[#0F172A] p-8 border border-gray-200 dark:border-[#1E293B] border-l-4 border-l-lab-blue dark:border-l-lab-orange shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-300 flex flex-col h-full rounded-sm">
        <span class="text-xs font-bold text-orange-600 dark:text-lab-orange uppercase tracking-widest mb-3 block">2017 – 2021</span>
        <h3 class="text-xl font-bold text-lab-dark dark:text-gray-100 mb-2">Millennium Nucleus 2017</h3>
        <p class="text-sm font-bold text-lab-blue dark:text-blue-400 mb-4">Young Investigator</p>
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-6 flex-grow leading-relaxed italic">
          "Millennium Nucleus of Ion Channels-Associated Diseases (MiNICAD)."
        </p>
        <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Universidad de Talca</p>
      </div>

      <div class="bg-slate-100 dark:bg-[#0F172A] p-8 border border-gray-200 dark:border-[#1E293B] border-l-4 border-l-lab-blue dark:border-l-lab-orange shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-300 flex flex-col h-full rounded-sm">
        <span class="text-xs font-bold text-orange-600 dark:text-lab-orange uppercase tracking-widest mb-3 block">2017 – 2020</span>
        <h3 class="text-xl font-bold text-lab-dark dark:text-gray-100 mb-2">Talca University Research Support</h3>
        <p class="text-sm font-bold text-lab-blue dark:text-blue-400 mb-4">Grant Recipient</p>
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-6 flex-grow leading-relaxed italic">
          "Desarrollo Nucleo Cientifico Multidiciplinario"
        </p>
        <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Universidad de Talca</p>
      </div>
    </div>

    <div class="flex justify-center border-t border-gray-200 dark:border-[#1E293B] pt-12">
      <a href="#hero" class="group flex flex-col items-center gap-2 text-xs font-bold uppercase tracking-[0.15em] text-gray-400 hover:text-orange-600 dark:hover:text-lab-orange transition-colors">
        <svg class="w-6 h-6 group-hover:-translate-y-2 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path></svg>
        Back to Top
      </a>
    </div>

  </div>
</section>