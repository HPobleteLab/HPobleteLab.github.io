---
// src/components/sections/HomeResearch.astro
---

<section id="research" class="scroll-mt-24 reveal relative border-y border-gray-200 dark:border-[#1E293B] min-h-[calc(100vh-6rem)] flex flex-col justify-center py-16 w-full transition-colors duration-300 odd:bg-slate-100 even:bg-white dark:odd:bg-[#0F172A] dark:even:bg-[#080D19]">
  <div class="max-w-7xl mx-auto px-6 w-full">
    <div class="mb-12">
      <h2 class="text-5xl md:text-6xl font-bold mb-8 text-lab-dark dark:text-gray-100">Research</h2>
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
        <p class="text-2xl md:text-3xl text-gray-600 dark:text-gray-400 leading-relaxed font-light max-w-4xl">
          We use state-of-the-art computational tools to simulate and understand the interface between biological molecules and engineered nanomaterials.
        </p>
        <a href="/research" class="group inline-flex items-center gap-3 text-base font-bold uppercase tracking-widest border-b-2 border-orange-600 dark:border-lab-orange pb-1 text-lab-dark dark:text-gray-200 hover:text-orange-600 dark:hover:text-lab-orange transition-colors whitespace-nowrap">
          View Research Lines
          <svg class="w-5 h-5 transition-transform duration-300 transform group-hover:translate-x-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="bg-white dark:bg-[#1E293B] border border-gray-200 dark:border-[#334155] border-l-4 border-l-lab-blue dark:border-l-lab-orange p-8 md:p-12 shadow-sm hover:shadow-xl hover:-translate-y-2 rounded-sm transition-all duration-300">
      <h3 class="text-sm font-bold uppercase tracking-widest mb-10 text-lab-blue dark:text-blue-400">Research Focus</h3>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-8 text-xl font-medium text-lab-dark dark:text-gray-200">
        <p>• Protein-Nanoparticle Interactions</p>
        <p>• Multi-scale Molecular Dynamics</p>
        <p>• Drug Delivery Systems</p>
      </div>
    </div>

  <div class="absolute bottom-6 left-1/2 transform -translate-x-1/2 flex flex-col items-center opacity-70 hover:opacity-100 transition-opacity animate-bounce">
    <a href="#team" aria-label="Scroll to Team" class="text-gray-400 dark:text-gray-500 hover:text-orange-600 dark:hover:text-lab-orange transition-colors">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
    </a>
  </div>
</section>