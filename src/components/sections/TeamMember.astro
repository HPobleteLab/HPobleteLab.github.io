---
// src/components/sections/TeamMember.astro
// Current member: round photo, name, role, short bio and links.
// Photos are shown in black and white; members without one get the placeholder.
import type { CollectionEntry } from 'astro:content';
import { memberLinks, NO_IMAGE } from '../../utils/collections';

interface Props {
  member: CollectionEntry<'team'>;
}

const { data } = Astro.props.member;
const links = memberLinks(data);
---

<article class="rise flex gap-5">
  <img
    src={data.image ?? NO_IMAGE}
    alt={data.image ? data.name : ''}
    width="96"
    height="96"
    loading="lazy"
    class="w-24 h-24 shrink-0 rounded-full object-cover grayscale bg-wash"
  />

  <div>
    <h3 class="font-medium text-lg leading-snug">{data.name}</h3>
    <p class="text-accent">{data.role}</p>

    {data.bio && <p class="mt-2 leading-relaxed text-muted">{data.bio}</p>}

    {links.length > 0 && (
      <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
        {links.map(({ label, href }) => (
          <a href={href} target={href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener noreferrer" class="link">{label}</a>
        ))}
      </p>
    )}
  </div>
</article>
