---
// src/components/sections/TeamMember.astro
// Current member: photo (or initials), name, role, short bio and links.
import type { CollectionEntry } from 'astro:content';
import { initials, memberLinks } from '../../utils/collections';

interface Props {
  member: CollectionEntry<'team'>;
}

const { data } = Astro.props.member;
const links = memberLinks(data);
---

<article>
  {data.image ? (
    <img src={data.image} alt={data.name} loading="lazy" class="w-full aspect-[4/5] object-cover bg-wash" />
  ) : (
    <div class="w-full aspect-[4/5] flex items-center justify-center bg-wash text-4xl font-medium text-muted/50" aria-hidden="true">
      {initials(data.name)}
    </div>
  )}

  <h3 class="mt-4 font-medium text-lg leading-snug">{data.name}</h3>
  <p class="text-muted">{data.role}</p>

  {data.bio && <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{data.bio}</p>}

  {links.length > 0 && (
    <p class="mt-3 text-[0.95rem] flex flex-wrap gap-x-4 gap-y-1">
      {links.map(({ label, href }) => (
        <a href={href} target={href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener noreferrer" class="link">{label}</a>
      ))}
    </p>
  )}
</article>
